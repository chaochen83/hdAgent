# 应用基础配置
APP_NAME=Makerfabs Agent
APP_URL=http://127.0.0.1:8848
DATABASE_URL=postgresql://hdagent_app:change_me_now@127.0.0.1:5432/hdagent
SESSION_SECRET=change-me-in-production
SESSION_COOKIE_NAME=makerfabs_session
SESSION_TTL_HOURS=168

# Google OAuth（启用 Google 登录时必填）
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# 邮箱验证码发送
# 开发期建议 EMAIL_PROVIDER=console，本地会把验证码打印到后端日志并可返回 dev_code
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
EMAIL_SUBJECT_PREFIX=[Makerfabs Agent]
EMAIL_DEBUG_EXPOSE_CODE=true

# 如果要接真实邮箱，请改成 EMAIL_PROVIDER=smtp 并配置以下项
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# 手机登录暂未启用，后续接入第三方验证码服务后改为 true
PHONE_LOGIN_ENABLED=false

# Qwen (阿里通义千问，OpenAI 兼容接口)
# 必填（如果使用 Qwen）
QWEN_API_KEY=your_qwen_api_key_here

# 可选：如果你使用的是自建 OpenAI 兼容网关，或者需要自定义域名
# 默认值：https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：默认使用的 Qwen 模型
# 例如：qwen-plus, qwen-max, qwen-turbo 等
QWEN_MODEL=qwen-plus


# OpenAI（ChatGPT，可选）
# 如果你打算在前端切换到 provider=openai，则需要设置：
OPENAI_API_KEY=your_openai_api_key_here

# 可选：默认 OpenAI 模型
# 例如：gpt-4.1-mini, gpt-4.1, gpt-4o 等
OPENAI_MODEL=gpt-4.1-mini


# Anthropic Claude（可选）
# 如果你打算在前端切换到 provider=claude，则需要设置：
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：默认 Claude 模型
# 例如：claude-3-5-sonnet-latest, claude-3-opus-20240229 等
CLAUDE_MODEL=claude-3-5-sonnet-latest


# DeepSeek（可选）
# 如果你打算在前端切换到 provider=deepseek，则需要设置：
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：DeepSeek OpenAI 兼容接口 base_url
# 默认值：https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：默认 DeepSeek 模型
# 例如：deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
